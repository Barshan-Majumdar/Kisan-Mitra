# ==============================================================================
# Kisan-Mitra Frontend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION - REQUIRED
# ------------------------------------------------------------------------------
# Obtain your Clerk Publishable Key from:
# https://dashboard.clerk.com -> Choose your application -> API Keys
#
# Development key starts with 'pk_test_' and production key starts with 'pk_live_'
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# ------------------------------------------------------------------------------
# 2. BACKEND API URL - OPTIONAL
# ------------------------------------------------------------------------------
# In local development, the backend runs on port 3000.
# Defaults to 'http://localhost:3000/api' if omitted.
VITE_API_URL="http://localhost:3000/api"

# For production deployment (e.g. Vercel), set to your deployed backend URL:
# VITE_API_URL="https://your-backend-api.vercel.app/api"
