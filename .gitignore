# Root .gitignore for Kisan-Mitra

# Dependencies
node_modules/

# Environment files - Keep secrets out of git!
.env
.env.local
.env.*.local
*.env
*.env.local
!.env.example
!**/.env.example

# Build outputs
dist/
dist-ssr/
build/
.vercel/
/generated/prisma

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Python & Large ML Artifacts (>100MB exceeds GitHub limits)
__pycache__/
*.py[cod]
*.pkl
*.joblib
*.csv
.venv/
venv/
scratch/
.agents

# Images & Media Assets
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.svg
*.webp
*.ico
*.tiff
*.avif
!frontend/public/favicon.svg
