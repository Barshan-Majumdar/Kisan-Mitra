# ==============================================================================
# Kisan-Mitra Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM) - REQUIRED
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL format:
# postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Local PostgreSQL example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisan_mitra?schema=public"
#
# Cloud PostgreSQL (Neon / Supabase / Aiven / Railway) example:
# DATABASE_URL="postgresql://user:password@ep-xyz-123456.ap-southeast-1.aws.neon.tech/kisan_mitra?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION - OPTIONAL
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI - REQUIRED FOR AI ADVISORY & CHATBOT
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# Primary Gemini API Key (used for both Crop Advisory & Chatbot by default):
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Separate keys if you want to partition rate limits / quotas:
# GEMINI_CROP_API_KEY=""
# GEMINI_CHAT_API_KEY=""

# ------------------------------------------------------------------------------
# 4. MACHINE LEARNING MODEL SERVICE - OPTIONAL
# ------------------------------------------------------------------------------
# Local Two-Stage Random Forest FastAPI Microservice (run in ai-service/):
CROP_PREDICTION_API_URL="http://127.0.0.1:8000/predict"
# Or use the remote hosted fallback endpoint:
# CROP_PREDICTION_API_URL="https://crop-model-api.onrender.com/predict"
