# ==============================================================================
# Kisan-Mitra Project Environment Variables Overview
# ==============================================================================
# This repository is organized into three applications:
# 1. ai-service/ -> Python 3.13 + FastAPI + Two-Stage Random Forest ML (Port 8000)
# 2. backend/    -> Node.js + Express + Prisma PostgreSQL + Gemini API (Port 3000)
# 3. frontend/   -> React 18 + Vite + Tailwind CSS + Clerk Auth (Port 5173)
#
# Follow the instructions below to configure environment files for your services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI MICROSERVICE (ai-service/)
# ------------------------------------------------------------------------------
# Run the local AI service:
# cd ai-service && python main.py
# Runs at: http://127.0.0.1:8000
# Health check: http://127.0.0.1:8000/health
# Dropdown options: http://127.0.0.1:8000/options


# ------------------------------------------------------------------------------
# 2. BACKEND (Copy to backend/.env)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisan_mitra?schema=public"

# Express server port & mode
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional separate Gemini keys (if not using GEMINI_API_KEY)
# GEMINI_CROP_API_KEY=""
# GEMINI_CHAT_API_KEY=""

# Crop Prediction AI endpoint (Points to local ai-service or hosted Render URL)
CROP_PREDICTION_API_URL="http://127.0.0.1:8000/predict"


# ------------------------------------------------------------------------------
# 3. FRONTEND (Copy to frontend/.env)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Get key from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# Backend API Base URL
VITE_API_URL="http://localhost:3000/api"
