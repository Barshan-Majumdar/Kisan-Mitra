# ==============================================================================
# Kisan-Mitra Project Environment Variables Overview
# ==============================================================================
# This repository is organized into two primary applications:
# 1. backend/  -> Node.js + Express + Prisma + Gemini API
# 2. frontend/ -> React + Vite + Tailwind CSS + Clerk
#
# Follow the instructions below to configure environment files for both apps.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (Copy to backend/.env)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kisan_mitra?schema=public"

# Express server port
PORT=3000

# Node environment mode
NODE_ENV=development

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional separate Gemini keys (if not using GEMINI_API_KEY)
# GEMINI_CROP_API_KEY=""
# GEMINI_CHAT_API_KEY=""

# Crop Prediction ML Model endpoint
CROP_PREDICTION_API_URL="https://crop-model-api.onrender.com/predict"


# ------------------------------------------------------------------------------
# FRONTEND (Copy to frontend/.env)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Get key from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# Backend API Base URL
VITE_API_URL="http://localhost:3000/api"
